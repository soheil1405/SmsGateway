# Arvan SMS API — نمونهٔ متغیرهای محیطی
# کپی برای کار لوکال:
#   cp .env.example .env.local
#
# این فایل برای اجرای اپ روی host در برابر docker compose است
# (پورت‌های mapped: Postgres 5433، Redis 6380، Kafka 9094، OTLP 4318).

# HTTP
ADDR=:8080

# Postgres
# DATABASE_URL=
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=arvan
DB_SSLMODE=disable

# Redis
REDIS_ADDR=localhost:6380

# Kafka
KAFKA_BROKERS=localhost:9094
KAFKA_TOPIC_NORMAL=sms.normal
KAFKA_TOPIC_EXPRESS=sms.express
KAFKA_TOPIC_DLQ=sms.dlq
KAFKA_GROUP_NORMAL=sms-normal-worker
KAFKA_GROUP_EXPRESS=sms-express-worker
SMS_WORKERS_NORMAL=2
SMS_WORKERS_EXPRESS=6
OUTBOX_MAX_ATTEMPTS=10

# OpenTelemetry (OTLP HTTP، بدون scheme)
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4318
OTEL_INSECURE=true
OTEL_SERVICE_NAME=arvan-api
